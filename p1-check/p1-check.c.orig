/*
 * CS 261 PA1: Mini-ELF header verifier
 *
 * Name: Jacob Grimes
 */

#include "p1-check.h"

/**********************************************************************
 *                         REQUIRED FUNCTIONS
 *********************************************************************/
/*
 * reads a header from a file and stores it into the hdr pointer.
 */
bool read_header (FILE *file, elf_hdr_t *hdr)
{
    if (file == NULL || hdr == NULL) {
        return false;
    }
    int ret = fread(hdr, sizeof(elf_hdr_t), 1, file);
    return ret == 1 && hdr->magic == 0x464c45;
}

/**********************************************************************
 *                         OPTIONAL FUNCTIONS
 *********************************************************************/
/*
 * prints the header to standard output
 * if the -H argument is put into the console.
*/
void dump_header (elf_hdr_t *hdr)
{
    // pointer to the beginning of the struct (version)
    uint16_t *pointer = &(hdr->e_version);

    // print header in little endian
    for (int i = 0; i < (sizeof(elf_hdr_t) / 2) - 1; i++) {
        // print a byte at a time, putting a space between every 
        // 4 bits (half byte) and another space every 4 bytes
        if (i > 0 && i % 4 == 0) {
            printf(" ");
        }
        printf("%02x %02x ", pointer[i] & 0xff, pointer[i] >> (8 & 0xff));
    }
    // print the last byte with no trailing white space
    printf("%02x %02x", pointer[sizeof(elf_hdr_t) / 2 - 1] & 0xff,
           pointer[sizeof(elf_hdr_t) / 2 - 1] >> (8 & 0xff));

    printf("\n");
    // print rest of output
    printf("Mini-ELF version %d\n", hdr->e_version);
    printf("Entry point 0x%x\n", hdr->e_entry);
    printf("There are %d program headers, starting at offset %d (0x%x)\n", hdr->e_num_phdr,
           hdr->e_phdr_start, hdr->e_phdr_start);
    if (hdr->e_symtab == 0) {
        printf("There is no symbol table present\n");
    } else {
        printf("There is a symbol table starting at offset %d (0x%x)\n", hdr->e_symtab, hdr->e_symtab);
    }
    if (hdr->e_strtab == 0) {
        printf("There is no string table present\n");
    } else {
        printf("There is a string table starting at offset %d (0x%x)\n", hdr->e_strtab, hdr->e_strtab);
    }
}

